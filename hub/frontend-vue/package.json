{
  "name": "aquatech-hub-frontend-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Vue 3 + TypeScript + Vite frontend voor gemigreerde AquaTech Hub-modules (bouwstap; niets hiervan draait in het runtime-image)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "stijl": "node tools/check-stijl.mjs",
    "build:shop": "vite build --config vite.shop-ssr.config.ts"
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.4.11",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "glob": "14.0.6"
  }
}
