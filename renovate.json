{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 9am on monday"],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies", "geen-releasenotes"],
  "packageRules": [
    {
      "description": "Minor en patch van alle managers in één groep-PR per week",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor en patch",
      "groupSlug": "minor-patch"
    },
    {
      "description": "Majors krijgen elk een eigen PR (standaard), niet automatisch samenvoegen",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "PostgreSQL blijft op major 17 (productie draait op PostgreSQL 17)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<18"
    }
  ]
}
