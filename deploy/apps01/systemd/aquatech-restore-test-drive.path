# Start de app-controle van de Drive-hersteltest zodra de app een aanvraag klaarzet (restore-test-drive.sh haalt het bestand direct weg).
[Unit]
Description=Aquatech: app-controle van de Drive-hersteltest starten op aanvraag vanuit de app

[Path]
PathExists=/opt/apps/aquatech/update/request/drive-restore/request.json
Unit=aquatech-restore-test-drive.service

[Install]
WantedBy=multi-user.target
