# Voorbeeld van .env voor de stagingomgeving (/opt/apps/aquatech-staging/.env). install-staging.sh maakt dit bestand bij de
# eerste installatie zelf (mode 600) en beheert de regels hieronder; niets hiervan hoeft met de hand. Geheimen staan niet
# in dit bestand maar in secrets/ (alleen daar).

# Commit van develop die nu draait; het script zet dit na een geslaagde uitrol (en terug bij een mislukte).
STAGING_COMMIT=
# Het IP-adres van de tunnelcontainer, met /32: de enige proxy die de app gelooft. Het script ververst dit bij elke run.
TRUSTED_PROXIES=
# De bestaande tunnel: naam van de container en van zijn netwerk (alleen-lezen overgenomen van de testomgeving).
TUNNEL_CONTAINER=
TUNNEL_NETWORK=
# Poort op 127.0.0.1 van de server (alleen voor controle op de server zelf).
STAGING_PORT=3310
TZ=Europe/Amsterdam
# Installatiecode voor het eerste beheerdersaccount (door het script gemaakt).
SETUP_CODE=

# Koppelingen staan bewust leeg of uit: geen mail, geen back-up naar buiten, geen betalingen, geen externe diensten.
# AI-herkenning alleen met een eigen sleutel met een lage daglimiet (liever in de app: Beheer > Instellingen).
ANTHROPIC_API_KEY=
# Vue-modules die in het staging-image worden meegebouwd (komma's); leeg = geen.
VUE_MODULES=
