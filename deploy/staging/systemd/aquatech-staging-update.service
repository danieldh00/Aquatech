# Staging bijwerken (update-staging.sh), gestart door aquatech-staging-update.timer.
[Unit]
Description=AquaTech staging bijwerken naar het nieuwste stagingimage
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/apps/aquatech-staging/update-staging.sh
TimeoutStartSec=15min
