# Kopieer naar .env (staat in .gitignore) en vul in wat je wilt. Alles is
# optioneel en alleen een startwaarde: in de app (Beheer > Instellingen)
# opgeslagen waarden gaan voor.

# Poort op de server
APP_PORT=3300
# Optionele gedeelde toegangscode (inloggen als beheerder zonder account).
# Is die gezet, dan vraagt het scherm voor de eerste beheerder er ook om.
ACCESS_CODE=
# Gasten zonder inloggen toestaan (true/false, standaard false)
GUEST_ACCESS=
# API-sleutel van Anthropic voor automatisch herkennen met AI
ANTHROPIC_API_KEY=
# Maximaal aantal AI-analyses per dag (leeg = 30)
AI_DAILY_LIMIT=
# Hoofdsleutel voor versleuteling (64 hex-tekens). Beter als Docker-secret
# (AQUATECH_MASTER_KEY_FILE, zie docker-compose.yml); leeg = /data/master-key.
AQUATECH_MASTER_KEY=
